@model EternaDemo.Models.ApplicationUser

@{
    ViewBag.Title = "User Details";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<br />
<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>User Details</h5>
        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Phone Number</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@((Model.SelectedAddress != null) ? Model.SelectedAddress.Street : "—")</dd>

            <dt class="col-sm-3">Email Confirmed</dt>
            <dd class="col-sm-9">
                @if (Model.EmailConfirmed)
                {
                    <span class="badge bg-success">Yes</span>
                }
                else
                {
                    <span class="badge bg-secondary">No</span>
                }
            </dd>

            <dt class="col-sm-3">Phone Confirmed</dt>
            <dd class="col-sm-9">
                @if (Model.PhoneNumberConfirmed)
                {
                    <span class="badge bg-success">Yes</span>
                }
                else
                {
                    <span class="badge bg-secondary">No</span>
                }
            </dd>

            <dt class="col-sm-3">Two-Factor Auth</dt>
            <dd class="col-sm-9">
                @if (Model.TwoFactorEnabled)
                {
                    <span class="badge bg-info">Enabled</span>
                }
                else
                {
                    <span class="badge bg-light text-muted">Off</span>
                }
            </dd>

            <dt class="col-sm-3">Lockout</dt>
            <dd class="col-sm-9">
                @if (Model.LockoutEnabled)
                {
                    <span class="badge bg-danger">Locked</span>
                }
                else
                {
                    <span class="badge bg-success">Active</span>
                }
            </dd>

            <dt class="col-sm-3">Failed Logins</dt>
            <dd class="col-sm-9">@Model.AccessFailedCount</dd>

            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.UserName</dd>
        </dl>
    </div>

    <div class="card-footer text-end">
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning me-2">
            <i class="bi bi-pencil-square me-1"></i> Edit
        </a>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle me-1"></i> Back to List
        </a>
    </div>
</div>
