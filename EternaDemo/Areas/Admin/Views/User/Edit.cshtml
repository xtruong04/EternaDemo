@model EternaDemo.Models.ApplicationUser

@{
    ViewBag.Title = "Edit User";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<br />
<div class="card shadow-sm border-0">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit User</h5>
        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Id)

        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Full Name</label>
                    @Html.EditorFor(m => m.FullName, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Email</label>
                    @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    @Html.EditorFor(m => m.PhoneNumber, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Default Address</label>
                    @Html.DropDownList("SelectedAddressId", null, "Select Address", new { @class = "form-select" })
                </div>

                <div class="col-md-4">
                    <div class="form-check mt-4">
                        @Html.CheckBoxFor(m => m.EmailConfirmed, new { @class = "form-check-input" })
                        <label class="form-check-label">Email Confirmed</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check mt-4">
                        @Html.CheckBoxFor(m => m.PhoneNumberConfirmed, new { @class = "form-check-input" })
                        <label class="form-check-label">Phone Confirmed</label>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-check mt-4">
                        @Html.CheckBoxFor(m => m.TwoFactorEnabled, new { @class = "form-check-input" })
                        <label class="form-check-label">Two-Factor Enabled</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Lockout End Date</label>
                    @Html.EditorFor(m => m.LockoutEndDateUtc, new { htmlAttributes = new { @class = "form-control", type = "datetime-local" } })
                </div>

                <div class="col-md-3">
                    <div class="form-check mt-4">
                        @Html.CheckBoxFor(m => m.LockoutEnabled, new { @class = "form-check-input" })
                        <label class="form-check-label">Lockout Enabled</label>
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Failed Attempts</label>
                    @Html.EditorFor(m => m.AccessFailedCount, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Username</label>
                    @Html.EditorFor(m => m.UserName, new { htmlAttributes = new { @class = "form-control" } })
                </div>
            </div>
        </div>

        <div class="card-footer text-end">
            <button type="submit" class="btn btn-primary me-2">
                <i class="bi bi-save me-1"></i> Save Changes
            </button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1"></i> Cancel
            </a>
        </div>
    }
</div>
