@model EternaDemo.Models.Order

@{
    ViewBag.Title = "Create New Order";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="fa fa-plus-circle me-2"></i>Create New Order</h4>
        <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
            <i class="fa fa-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Customer</label>
                    @Html.DropDownList("UserId", null, "-- Select User --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.UserId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Shipping Address</label>
                    @Html.DropDownList("AddressId", null, "-- Select Address --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.AddressId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Order Status</label>
                    @Html.EnumDropDownListFor(m => m.Status, new { @class = "form-select" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Payment Status</label>
                    @Html.EnumDropDownListFor(m => m.PaymentStatus, new { @class = "form-select" })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Payment Method</label>
                    @Html.EditorFor(m => m.PaymentMethod, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Transaction ID</label>
                    @Html.EditorFor(m => m.TransactionId, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Payment Provider</label>
                    @Html.EditorFor(m => m.PaymentProvider, new { htmlAttributes = new { @class = "form-control" } })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Subtotal</label>
                    @Html.EditorFor(m => m.Subtotal, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01" } })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Shipping Fee</label>
                    @Html.EditorFor(m => m.ShippingFee, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01" } })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Tax</label>
                    @Html.EditorFor(m => m.Tax, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01" } })
                </div>

                <div class="col-md-4">
                    <label class="form-label">Total</label>
                    @Html.EditorFor(m => m.Total, new { htmlAttributes = new { @class = "form-control", type = "number", step = "0.01" } })
                </div>

                <div class="col-md-8">
                    <label class="form-label">Gift Message</label>
                    @Html.TextAreaFor(m => m.GiftMessage, new { @class = "form-control", rows = 2 })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Created At</label>
                    @Html.TextBoxFor(m => m.CreatedAt, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Updated At</label>
                    @Html.TextBoxFor(m => m.UpdatedAt, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                </div>

                <div class="col-md-6">
                    <label class="form-label">Paid At</label>
                    @Html.TextBoxFor(m => m.PaidAt, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                </div>

                <div class="col-md-6 d-flex align-items-center mt-3">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.GiftWrap, new { @class = "form-check-input", id = "giftWrapCheck" })
                        <label class="form-check-label" for="giftWrapCheck">Gift Wrap</label>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-end">
                <button type="submit" class="btn btn-success px-4">
                    <i class="fa fa-save me-1"></i> Save Order
                </button>
            </div>
        }
    </div>
</div>
