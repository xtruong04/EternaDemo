@model IEnumerable<EternaDemo.Models.Order>

@{
    ViewBag.Title = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-gold text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-bag-check me-2"></i> My Orders
            </h4>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>#@order.Id</strong></td>
                                <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @switch (order.Status)
                                    {
                                        case EternaDemo.Models.Order.OrderStatus.Pending:
                                            <span class="badge bg-warning text-dark">@order.Status</span>; break;
                                        case EternaDemo.Models.Order.OrderStatus.Processing:
                                            <span class="badge bg-info text-dark">@order.Status</span>; break;
                                        case EternaDemo.Models.Order.OrderStatus.Shipped:
                                            <span class="badge bg-primary">@order.Status</span>; break;
                                        case EternaDemo.Models.Order.OrderStatus.Delivered:
                                            <span class="badge bg-success">@order.Status</span>; break;
                                        default:
                                            <span class="badge bg-secondary">@order.Status</span>; break;
                                    }
                                </td>
                                <td>
                                    @if (order.PaymentStatus == EternaDemo.Models.Order.PaymentState.Paid)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (order.PaymentStatus == EternaDemo.Models.Order.PaymentState.Refunded)
                                    {
                                        <span class="badge bg-secondary">Refunded</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Unpaid</span>
                                    }
                                </td>
                                <td>
                                    <strong>@(order.Items != null ? (order.Items.Sum(x => x.Subtotal)+order.ShippingFee).ToString("#,##0") + " VND" : "0 VND")</strong>
                                </td>
                                <td>
                                    <a href="@Url.Action("OrderDetails", "Order", new { id = order.Id })"
                                       class="btn btn-sm btn-outline-gold">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-inbox fs-3"></i>
                    <p class="mt-2 mb-0">You haven't placed any orders yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .bg-gold {
        background-color: #c89b3c;
    }

    .btn-outline-gold {
        border: 1px solid #c89b3c;
        color: #c89b3c;
        border-radius: 25px;
        transition: 0.3s;
    }

        .btn-outline-gold:hover {
            background-color: #c89b3c;
            color: white;
        }
</style>
