@model EternaDemo.Models.ApplicationUser

@{
    ViewBag.Title = "Edit Profile";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background-color: #f9f9f9;
        font-family: 'Poppins', sans-serif;
    }

    .edit-card {
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        border: none;
        margin-top: 120px;
    }

    .edit-header {
        background-color: #c89b3c;
        color: white;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

    .form-control {
        border-radius: 10px;
        padding: 10px 12px;
    }

    .btn-gold {
        background-color: #c89b3c;
        border: none;
        border-radius: 25px;
        color: #fff;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-gold:hover {
            background-color: #b68a32;
        }

    .btn-outline-gold {
        border: 1px solid #c89b3c;
        color: #c89b3c;
        border-radius: 25px;
        transition: 0.3s;
    }

        .btn-outline-gold:hover {
            background-color: #c89b3c;
            color: white;
        }

    .address-box {
        background-color: #fffaf2;
        border: 1px solid #f1e0c6;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 10px;
    }

        .address-box p {
            margin: 0;
            color: #333;
        }

    .form-label {
        font-weight: 500;
    }
</style>

<div class="container" style="max-width: 720px;">
    <div class="card edit-card">
        <div class="card-header edit-header">
            <h4 class="mb-0">
                <i class="bi bi-pencil-square me-2"></i>Edit Profile
            </h4>
        </div>

        <div class="card-body p-4">
            @using (Html.BeginForm("EditProfile", "User", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="text" class="form-control" value="@Model.Email" readonly />
                </div>

                <!-- Full name -->
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Enter your full name..." })
                </div>

                <!-- Phone -->
                <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Enter your phone number..." })
                </div>

                <!-- Địa chỉ -->
        <div class="mb-3">
            <label class="form-label">Address</label>
            @if (Model.Addresses != null && Model.Addresses.Any())
            {
                <select class="form-select mb-2" name="SelectedAddressId">
                    @foreach (var addr in Model.Addresses)
                    {
                        <option value="@addr.Id" @(Model.SelectedAddressId == addr.Id ? "selected" : "")>
                            @addr.Street, @addr.City
                        </option>
                    }
                </select>

                <a href="@Url.Action("AddAddress", "Address")" class="btn btn-sm btn-outline-gold">
                    <i class="bi bi-plus-circle me-1"></i> Add New Address
                </a>
            }
            else
            {
                <p class="text-muted fst-italic mb-2">You have no saved addresses.</p>
                <a href="@Url.Action("AddAddress", "Address")" class="btn btn-sm btn-outline-gold">
                    <i class="bi bi-plus-circle me-1"></i> Add New Address
                </a>
            }
        </div>

                <button type="submit" class="btn btn-gold w-100 mt-3">
                    <i class="bi bi-check2-circle me-2"></i>Save Changes
                </button>
            }
        </div>
    </div>
</div>
