@model EternaDemo.Models.ApplicationUser
@{
    ViewBag.Title = "My Account";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<style>
    body {
        background-color: #f8f8f8 !important;
        font-family: 'Poppins', sans-serif;
    }

    .account-wrapper {
        margin-top: 120px;
        margin-bottom: 80px;
    }

    /* Sidebar */
    .profile-sidebar {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        padding: 30px;
        text-align: center;
        transition: all 0.3s ease;
    }

        .profile-sidebar:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.08);
        }

        .profile-sidebar img {
            width: 95px;
            height: 95px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 12px;
            border: 3px solid #f1f1f1;
        }

        .profile-sidebar h6 {
            font-weight: 600;
            margin-bottom: 3px;
            color: #222;
        }

        .profile-sidebar p {
            font-size: 14px;
            color: #666;
        }

    .btn-logout {
        border: 1px solid #c89b3c;
        color: #c89b3c;
        border-radius: 25px;
        font-size: 14px;
        padding: 5px 18px;
        margin-top: 10px;
        transition: 0.3s;
    }

        .btn-logout:hover {
            background-color: #c89b3c;
            color: white;
        }

    .menu-link {
        display: block;
        color: #555;
        text-decoration: none;
        font-weight: 500;
        padding: 8px 0;
        transition: 0.2s;
    }

        .menu-link:hover {
            color: #c89b3c;
            transform: translateX(4px);
        }

    /* Profile content */
    .profile-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        padding: 35px;
        transition: all 0.3s ease;
    }

        .profile-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.08);
        }

        .profile-card h4 {
            font-weight: 600;
            color: #222;
        }

        .profile-card hr {
            border-color: #eee;
            margin-top: 10px;
            margin-bottom: 20px;
        }

        .profile-card label {
            font-size: 13px;
            color: #888;
        }

        .profile-card p {
            font-weight: 500;
            color: #333;
        }

    .btn-gold {
        border: 1px solid #c89b3c;
        color: #c89b3c;
        border-radius: 25px;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-gold:hover {
            background-color: #c89b3c;
            color: #fff;
        }

    .highlight {
        color: #c89b3c;
    }

    select.form-select {
        border-radius: 10px;
        border: 1px solid #ddd;
        padding: 8px 12px;
    }
</style>

<div class="container account-wrapper">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-4 col-lg-3 mb-4">
            <div class="profile-sidebar">
                <img src="https://cdn-icons-png.flaticon.com/512/847/847969.png" alt="Avatar" />
                <h6>Hello,</h6>
                <p>@Model.Email</p>

                @using Microsoft.AspNet.Identity

                @if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
    {
                @Html.AntiForgeryToken()
                <a href="javascript:document.getElementById('logoutForm').submit()" class="btn btn-logout">
                    Logout
                </a>
    }
}

                <div class="text-start mt-4">
                    <p class="fw-semibold mb-1">Total Spend:</p>
                    <p class="fw-bold highlight">0 VND</p>
                </div>

                <hr>

                <div class="text-start">
                    <a href="@Url.Action("UserProfile", "User")" class="menu-link">
                        <i class="bi bi-person me-2"></i>Account
                    </a>
                    <a href="@Url.Action("Index", "Order")" class="menu-link">
                        <i class="bi bi-bag-check me-2"></i>Orders
                    </a>
                </div>
            </div>
        </div>

        <!-- Main content -->
        <div class="col-md-8 col-lg-9">
            <div class="profile-card">
                <h4><i class="bi bi-person-circle me-2 highlight"></i>My Account</h4>
                <hr />
                <p class="text-muted mb-4">Welcome to <span class="fw-semibold highlight">Eterna Store</span></p>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label>Email</label>
                        <p>@Model.Email</p>
                    </div>
                    <div class="col-md-6">
                        <label>Full Name</label>
                        <p>@(string.IsNullOrEmpty(Model.FullName) ? "No update" : Model.FullName)</p>
                    </div>
                    <div class="col-md-6">
                        <label>Phone</label>
                        <p>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "No update" : Model.PhoneNumber)</p>
                    </div>

                     Địa chỉ 
                    <div class="col-md-6">
                        <label class="text-muted small">Address</label>
                        @if (Model.SelectedAddress != null)
                        {
                            <p class="fw-semibold">@Model.SelectedAddress.Street, @Model.SelectedAddress.City</p>
                        }
                        else if (Model.Addresses != null && Model.Addresses.Any())
                        {
                            <p class="fw-semibold">@Model.Addresses.First().Street, @Model.Addresses.First().City</p>
                        }
                        else
                        {
                            <p class="text-muted fst-italic">No address added</p>
                        }
                    </div>
                </div>

                <div class="text-end mt-4">
                    <a href="@Url.Action("EditProfile", "User")" class="btn btn-gold px-4">
                        <i class="bi bi-pencil me-2"></i>Edit Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
