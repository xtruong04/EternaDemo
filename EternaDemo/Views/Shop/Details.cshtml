@model EternaDemo.Models.Product

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- breadcrumb -->
<div class="container">
    <div class="bread-crumb flex-w p-l-25 p-r-15 p-t-30 p-lr-0-lg">
        <a href="@Url.Action("Index", "Shop")" class="stext-109 cl8 hov-cl1 trans-04">
            Home
            <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
        </a>

        <a href="@Url.Action("Index", "Shop")" class="stext-109 cl8 hov-cl1 trans-04">
            @Model.Category.Name
            <i class="fa fa-angle-right m-l-9 m-r-10" aria-hidden="true"></i>
        </a>

        <span class="stext-109 cl4">
            @Model.Name
        </span>
    </div>
</div>


<!-- Product Detail -->
<section class="sec-product-detail bg0 p-t-65 p-b-60">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-lg-7 p-b-30">
                <div class="p-l-25 p-r-30 p-lr-0-lg">
                    <div class="wrap-slick3 flex-sb flex-w">
                        <div class="wrap-slick3-dots"></div>
                        <div class="wrap-slick3-arrows flex-sb-m flex-w"></div>

                        <div class="slick3 gallery-lb">
                            @foreach (var item in Model.ProductImages)
                            {
                                <div class="item-slick3" data-thumb="@item.Url">
                                    <div class="wrap-pic-w pos-relative">
                                        <img src="@item.Url" alt="@Model.Name" />

                                        <a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04"
                                           href="@item.Url">
                                            <i class="fa fa-expand"></i>
                                        </a>
                                    </div>
                                </div>

                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-5 p-b-30">
                <div class="p-r-50 p-t-5 p-lr-0-lg">
                    <h4 class="mtext-105 cl2 js-name-detail p-b-14">
                        @Model.Name
                    </h4>

                    <span class="mtext-106 cl2">
                        @Model.Price.ToString("#,##0") VND
                    </span>

                    @*<p class="stext-102 cl3 p-t-23">
                @Model.Alias
            </p>*@
                    <p class="stext-102 cl3 p-t-23">
                        Metal: @Model.Metal.Name
                    </p>
                    <p class="stext-102 cl3 p-t-23">
                        Gemstone: @Model.Gemstone.Name
                    </p>
                    <p class="stext-102 cl3 p-t-23">
                        Certificate: @Model.Certificate.Type
                    </p>
                    <div class="flex-w flex-r-m p-b-10">
                        <div class="size-204 flex-w flex-m respon6-next">
                            <form class="add-to-cart-form" action="/Cart/AddToCart" method="post">
                                <div class="wrap-num-product flex-w m-r-20 m-tb-10">
                                    <div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m">
                                        <i class="fs-16 zmdi zmdi-minus"></i>
                                    </div>

                                    <input class="mtext-104 cl3 txt-center num-product"
                                           type="number"
                                           name="quantity"
                                           value="1"
                                           min="1">

                                    <div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m">
                                        <i class="fs-16 zmdi zmdi-plus"></i>
                                    </div>
                                </div>

                                <input type="hidden" name="productId" value="@Model.Id" />

                                <button type="submit"
                                        class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 add-to-cart"
                                        data-id="@Model.Id">
                                    Add to cart
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!--  -->
                <div class="flex-w flex-m p-l-100 p-t-40 respon7" style="align-items: center;">
                    <!-- Nút tim -->
                    <div class="flex-m bor9 p-r-10 m-r-11" style="display: flex; align-items: center; position: relative;">
                        <a href="javascript:void(0);"
                           class="btn-addwish dis-block pos-relative"
                           data-product-id="@Model.Id"
                           style="display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; position: relative;">

                            <!-- Tim trắng -->
                            <img class="icon-heart1 dis-block trans-04"
                                 src="/Content/clientpage/assets/images/icons/icon-heart-01.png"
                                 alt="ICON"
                                 style="width:20px; height:20px; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%);">

                            <!-- Tim xanh -->
                            <img class="icon-heart2 dis-block trans-04 d-none"
                                 src="/Content/clientpage/assets/images/icons/icon-heart-02.png"
                                 alt="ICON"
                                 style="width:20px; height:20px; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%);">
                        </a>
                    </div>

                    <!-- Mạng xã hội -->
                    <a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100"
                       data-tooltip="Facebook"
                       style="display:flex; align-items:center;">
                        <i class="fa fa-facebook"></i>
                    </a>

                    <a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100"
                       data-tooltip="Twitter"
                       style="display:flex; align-items:center;">
                        <i class="fa fa-twitter"></i>
                    </a>

                    <a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100"
                       data-tooltip="Google Plus"
                       style="display:flex; align-items:center;">
                        <i class="fa fa-google-plus"></i>
                    </a>
                </div>

            </div>
        </div>
    </div>

    <div class="bor10 m-t-50 p-t-43 p-b-40">
        <!-- Tab01 -->
        <div class="tab01">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item p-b-10">
                    <a class="nav-link active" data-toggle="tab" href="#description" role="tab">Description</a>
                </li>

                <li class="nav-item p-b-10">
                    <a class="nav-link" data-toggle="tab" href="#information" role="tab">Additional information</a>
                </li>

                <li class="nav-item p-b-10">
                    <a class="nav-link" data-toggle="tab" href="#reviews" role="tab">Reviews (1)</a>
                </li>
            </ul>

            <!-- Tab panes -->
            <div class="tab-content p-t-43">
                <!-- - -->
                <div class="tab-pane fade show active" id="description" role="tabpanel">
                    <div class="how-pos2 p-lr-15-md">
                        <p class="stext-102 cl6">
                            @Model.Description
                        </p>
                    </div>
                </div>

                <!-- - -->
                <div class="tab-pane fade" id="information" role="tabpanel">
                    <div class="row">
                        <div class="col-sm-10 col-md-8 col-lg-6 m-lr-auto">
                            <ul class="p-lr-28 p-lr-15-sm">
                                <li class="flex-w flex-t p-b-7">
                                    <span class="stext-102 cl3 size-206">
                                        Metal: @Model.Metal.Name
                                    </span>

                                    <span class="stext-102 cl6 size-205">
                                        @Model.Metal.Purity
                                    </span>
                                </li>

                                <li class="flex-w flex-t p-b-7">
                                    <span class="stext-102 cl3 size-206">
                                        Gemstone: @Model.Gemstone.Name
                                    </span>

                                    <span class="stext-102 cl6 size-205">
                                        @Model.Gemstone.Carat Carat
                                    </span>
                                </li>

                                <li class="flex-w flex-t p-b-7">
                                    <span class="stext-102 cl3 size-206">
                                        Certificate: @Model.Certificate.Type
                                    </span>

                                    <span class="stext-102 cl6 size-205">
                                        @Model.Certificate.Number
                                    </span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- - -->
                <div class="tab-pane fade" id="reviews" role="tabpanel">
                    <div class="row">
                        <div class="col-sm-10 col-md-8 col-lg-6 m-lr-auto">
                            <div class="p-b-30 m-lr-15-sm">
                                <!-- Review -->
                                <div class="flex-w flex-t p-b-68">
                                    <div class="wrap-pic-s size-109 bor0 of-hidden m-r-18 m-t-6">
                                        <img src="images/avatar-01.jpg" alt="AVATAR">
                                    </div>

                                    <div class="size-207">
                                        <div class="flex-w flex-sb-m p-b-17">
                                            <span class="mtext-107 cl2 p-r-20">
                                                Ariana Grande
                                            </span>

                                            <span class="fs-18 cl11">
                                                <i class="zmdi zmdi-star"></i>
                                                <i class="zmdi zmdi-star"></i>
                                                <i class="zmdi zmdi-star"></i>
                                                <i class="zmdi zmdi-star"></i>
                                                <i class="zmdi zmdi-star-half"></i>
                                            </span>
                                        </div>

                                        <p class="stext-102 cl6">
                                            Quod autem in homine praestantissimum atque optimum est, id deseruit. Apud ceteros autem philosophos
                                        </p>
                                    </div>
                                </div>

                                <!-- Add review -->
                                <form class="w-full">
                                    <h5 class="mtext-108 cl2 p-b-7">
                                        Add a review
                                    </h5>

                                    <p class="stext-102 cl6">
                                        Your email address will not be published. Required fields are marked *
                                    </p>

                                    <div class="flex-w flex-m p-t-50 p-b-23">
                                        <span class="stext-102 cl3 m-r-16">
                                            Your Rating
                                        </span>

                                        <span class="wrap-rating fs-18 cl11 pointer">
                                            <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                                            <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                                            <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                                            <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                                            <i class="item-rating pointer zmdi zmdi-star-outline"></i>
                                            <input class="dis-none" type="number" name="rating">
                                        </span>
                                    </div>

                                    <div class="row p-b-25">
                                        <div class="col-12 p-b-5">
                                            <label class="stext-102 cl3" for="review">Your review</label>
                                            <textarea class="size-110 bor8 stext-102 cl2 p-lr-20 p-tb-10" id="review" name="review"></textarea>
                                        </div>

                                        <div class="col-sm-6 p-b-5">
                                            <label class="stext-102 cl3" for="name">Name</label>
                                            <input class="size-111 bor8 stext-102 cl2 p-lr-20" id="name" type="text" name="name">
                                        </div>

                                        <div class="col-sm-6 p-b-5">
                                            <label class="stext-102 cl3" for="email">Email</label>
                                            <input class="size-111 bor8 stext-102 cl2 p-lr-20" id="email" type="text" name="email">
                                        </div>
                                    </div>

                                    <button class="flex-c-m stext-101 cl0 size-112 bg7 bor11 hov-btn3 p-lr-15 trans-04 m-b-10">
                                        Submit
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg6 flex-c-m flex-w size-302 m-t-73 p-tb-15">
        <span class="stext-107 cl6 p-lr-25">
            SKU: @Model.Alias
        </span>
    </div>
    <script>
        $(document).on('submit', '.add-to-cart-form', function (e) {
            e.preventDefault();
            var form = $(this);

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        // Cập nhật số trên icon giỏ hàng
                        $('.icon-header-noti').attr('data-notify', response.count);

                        // Thông báo nhỏ
                        Swal.fire({
                            icon: 'success',
                            title: 'Đã thêm vào giỏ hàng!',
                            timer: 1000,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire({
                            icon: 'warning',
                            title: response.message,
                        });
                    }
                }
            });
        });

    </script>
</section>


<!-- Related Products -->
@Html.Action("RelatedProducts", "Shop", new { proId = Model.Id, cateId = Model.CateId })
@section scripts {
    <script>
        $(document).on("click", ".btn-addwish", function (e) {
            e.preventDefault();
            var btn = $(this);
            var productId = btn.data("product-id");

            $.ajax({
                url: '@Url.Action("Add", "Wishlist")',
                type: 'POST',
                data: { productId: productId },
                success: function (res) {
                    if (res.success) {
                        btn.find(".icon-heart1").addClass("d-none");
                        btn.find(".icon-heart2").removeClass("d-none");
                        alert("Đã thêm vào Wishlist!");
                    } else if (res.message) {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Vui lòng đăng nhập để thêm sản phẩm vào Wishlist!");
                }
            });
        });
    </script>
}