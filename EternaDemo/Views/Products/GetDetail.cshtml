@model EternaDemo.Models.Product
<div class="quick-view-content" style="margin-top: 120px;">
    <div class="overlay-modal1 js-hide-modal1"></div>

    <div class="container">
        <div class="bg0 p-t-60 p-b-30 p-lr-15-lg how-pos3-parent">
            <button class="how-pos3 hov3 trans-04 js-hide-modal1">
                <img src="~/Content/clientpage/assets/images/icons/icon-close.png" alt="CLOSE">
            </button>

            <div class="row">
                <div class="col-md-6 col-lg-7 p-b-30">
                    <div class="p-l-25 p-r-30 p-lr-0-lg">
                        <div class="wrap-slick3 flex-sb flex-w">
                            <div class="wrap-slick3-dots"></div>
                            <div class="wrap-slick3-arrows flex-sb-m flex-w"></div>

                            <div class="slick3 gallery-lb">
                                @foreach (var item in Model.ProductImages)
                                {
                                    <div class="item-slick3" data-thumb="@item.Url">
                                        <div class="wrap-pic-w pos-relative">
                                            <img src="@item.Url" alt="IMG-PRODUCT">

                                            <a class="flex-c-m size-108 how-pos1 bor0 fs-16 cl10 bg0 hov-btn3 trans-04" href="@item.Url">
                                                <i class="fa fa-expand"></i>
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-5 p-b-30">
                    <div class="p-r-50 p-t-5 p-lr-0-lg">
                        <h4 class="mtext-105 cl2 js-name-detail p-b-14">
                            @Model.Name
                        </h4>

                        <span class="mtext-106 cl2">
                            @Model.Price.ToString("#,##0") VND
                        </span>

                        <p class="stext-102 cl3 p-t-23">
                            @Model.Description
                        </p>

                        <!--  -->
                        @*<div class="p-t-33">
                            <div class="flex-w flex-r-m p-b-10">
                                <div class="size-203 flex-c-m respon6">
                                    Size
                                </div>

                                <div class="size-204 respon6-next">
                                    <div class="rs1-select2 bor8 bg0">
                                        <select class="js-select2" name="time">
                                            <option>Choose an option</option>
                                            <option>Size 7</option>
                                            <option>Size 8</option>
                                            <option>Size 9</option>
                                            <option>Size 10</option>
                                        </select>
                                        <div class="dropDownSelect2"></div>
                                    </div>
                                </div>
                            </div>*@

                        @*<div class="flex-w flex-r-m p-b-10">
                                <div class="size-203 flex-c-m respon6">
                                    Color
                                </div>

                                <div class="size-204 respon6-next">
                                    <div class="rs1-select2 bor8 bg0">
                                        <select class="js-select2" name="time">
                                            <option>Choose an option</option>
                                            <option>Red</option>
                                            <option>Blue</option>
                                            <option>White</option>
                                            <option>Grey</option>
                                        </select>
                                        <div class="dropDownSelect2"></div>
                                    </div>
                                </div>
                            </div>*@


                    </div>
                    <div class="flex-w flex-r-m p-b-10">
                        <div class="size-204 flex-w flex-m respon6-next">
                            <form class="add-to-cart-form" action="/Cart/AddToCart" method="post">
                                <div class="wrap-num-product flex-w m-r-20 m-tb-10">
                                    <div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m">
                                        <i class="fs-16 zmdi zmdi-minus"></i>
                                    </div>

                                    <input class="mtext-104 cl3 txt-center num-product"
                                           type="number"
                                           name="quantity"
                                           value="1"
                                           min="1">

                                    <div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m">
                                        <i class="fs-16 zmdi zmdi-plus"></i>
                                    </div>
                                </div>

                                <input type="hidden" name="productId" value="@Model.Id" />

                                <button type="submit"
                                        class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04 add-to-cart"
                                        data-id="@Model.Id">
                                    Add to cart
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!--  -->
                <div class="flex-w flex-m p-l-100 p-t-40 respon7">
                    <div class="flex-m bor9 p-r-10 m-r-11">
                        <a href="javascript:void(0);" onclick="addwish(@Model.Id)"
                           class="btn-addwish dis-block pos-relative"
                           data-product-id="@Model.Id">
                            <img class="icon-heart1 dis-block trans-04" src="/Content/clientpage/assets/images/icons/icon-heart-01.png" alt="ICON">
                            <img class="icon-heart2 dis-block trans-04 ab-t-l d-none" src="/Content/clientpage/assets/images/icons/icon-heart-02.png" alt="ICON">
                        </a>
                    </div>

                    <a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Facebook">
                        <i class="fa fa-facebook"></i>
                    </a>

                    <a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Twitter">
                        <i class="fa fa-twitter"></i>
                    </a>

                    <a href="#" class="fs-14 cl3 hov-cl1 trans-04 lh-10 p-lr-5 p-tb-2 m-r-8 tooltip100" data-tooltip="Google Plus">
                        <i class="fa fa-google-plus"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Gắn sự kiện click cho các nút tăng/giảm số lượng
        $(document).on('click', '.btn-num-product-down', function () {
            let num = Number($(this).siblings('.num-product').val());
            if (num > 1) $(this).siblings('.num-product').val(num - 1);
        });

        $(document).on('click', '.btn-num-product-up', function () {
            let num = Number($(this).siblings('.num-product').val());
            $(this).siblings('.num-product').val(num + 1);
        });

        // Gắn sự kiện đóng modal
        $(document).on('click', '.js-hide-modal1', function () {
            $('.quick-view-content').fadeOut(200);
        });

        // Bắt sự kiện submit form AddToCart
        // Sử dụng .off() trước .on() để đảm bảo sự kiện chỉ được gắn một lần duy nhất
        $(document).off('submit', '.add-to-cart-form').on('submit', '.add-to-cart-form', function (e) {
            e.preventDefault(); // Ngăn reload trang

            var form = $(this);

            $.ajax({
                url: form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (response) {
                    if (response.success) {
                        // Cập nhật số trên icon giỏ hàng
                        $('.icon-header-noti').attr('data-notify', response.count);

                        // Hiển thị thông báo thành công và tự đóng modal sau 1 giây
                        Swal.fire({
                            icon: 'success',
                            title: 'Add To Cart Success!',
                            showConfirmButton: false,
                            timer: 1000
                        }).then(() => {
                            // Đóng modal sau khi thông báo hoàn tất
                            $('.js-hide-modal1').click();
                        });

                    } else {
                        // Hiển thị cảnh báo và yêu cầu đăng nhập
                        Swal.fire({
                            icon: 'warning',
                            title: response.message,
                            showCancelButton: true,
                            confirmButtonText: 'Login',
                            cancelButtonText: 'Cancel',
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // Chuyển sang trang login của ASP.NET Identity
                                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                            }
                        });
                    }
                },
                error: function () {
                    // Hiển thị thông báo lỗi
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: 'Đã xảy ra lỗi khi thêm sản phẩm. Vui lòng thử lại.'
                    });
                }
            });
        });
    });

</script>

<script>
    function addwish(productId) {
        $.ajax({
            url: '/Wishlist/Add',
            type: 'POST',
            data: { productId: productId },
            success: function (response) {
                if (response.success) {
                    // Cập nhật số trên icon giỏ hàng
                    $('.icon-header-noti').attr('data-notify', response.count);

                    // Hiển thị thông báo thành công và tự đóng modal sau 1 giây
                    Swal.fire({
                        icon: 'success',
                        title: 'Add To Wishlist Success!',
                        showConfirmButton: false,
                        timer: 1000
                    }).then(() => {
                        // Đóng modal sau khi thông báo hoàn tất
                        $('.js-hide-modal1').click();
                    });

                } else {
                    // Hiển thị cảnh báo và yêu cầu đăng nhập
                    Swal.fire({
                        icon: 'warning',
                        title: response.message,
                        showCancelButton: true,
                        confirmButtonText: 'Login',
                        cancelButtonText: 'Cancel',
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Chuyển sang trang login của ASP.NET Identity
                            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                        }
                    });
                }
            },
            error: function () {
                // Hiển thị thông báo lỗi
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'Đã xảy ra lỗi khi thêm sản phẩm. Vui lòng thử lại.'
                });
            }
        });
    }
</script>
<script>
    $(document).ready(function () {
        $('.wrap-slick3').each(function () {
            var $this = $(this);
            var $slick3 = $this.find('.slick3');

            $slick3.slick({
                slidesToShow: 1,
                slidesToScroll: 1,
                fade: true,
                infinite: true,
                arrows: true,
                dots: true, // Bật thumbnail
                appendArrows: $this.find('.wrap-slick3-arrows'),
                appendDots: $this.find('.wrap-slick3-dots'),
                prevArrow: '<button type="button" class="slick-prev slick-arrow"><i class="fa fa-chevron-left"></i></button>',
                nextArrow: '<button type="button" class="slick-next slick-arrow"><i class="fa fa-chevron-right"></i></button>',

                // Tạo thumbnail từ data-thumb
                customPaging: function (slick, index) {
                    var thumb = $(slick.$slides[index]).data('thumb');
                    return '<img src="' + thumb + '" class="thumb-img"/>';
                }
            });
        });
    });
</script>
<style>
    /* ==== THUMBNAIL ==== */
    .wrap-slick3-dots {
        display: flex !important;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        margin-right: 15px;
    }

        .wrap-slick3-dots ul {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .wrap-slick3-dots img.thumb-img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 6px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }

        .wrap-slick3-dots .slick-active img.thumb-img {
            border-color: #ff6600;
            transform: scale(1.05);
        }

    /* ==== MŨI TÊN ==== */
    .slick-arrow {
        background: rgba(0, 0, 0, 0.5);
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex !important;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        z-index: 10;
        transition: all 0.3s ease;
        border: none;
    }

        .slick-arrow:hover {
            background: #ff6600;
            transform: scale(1.1);
        }

    .slick-prev {
        left: -20px;
    }

    .slick-next {
        right: -20px;
    }
</style>
